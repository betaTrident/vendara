---
import { LANDING_CTAS } from "../../lib/marketing/landing-content";
---

<section class="cta">
  <div class="wrap cta-box">
    <div>
      <h2>Ready to bring order to the store record?</h2>
      <p>
        Request approval from the person who manages your store's Vendara access, then sign in
        with your approved administrator account.
      </p>
    </div>
    <div class="cta-actions">
      <button class="button primary" type="button" data-access-trigger>Request access</button>
      <a class="button" href={LANDING_CTAS.adminSignIn}>Admin sign in</a>
    </div>
  </div>
</section>
