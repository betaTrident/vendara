{
  "name": "vendara",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "node --env-file=.env scripts/db-push.mjs",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:migrate:status": "node --env-file=.env scripts/db-migrate.mjs --status",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "lint": "biome check --linter-enabled=false src/lib/pwa src/pages/api/health.ts tests/pwa-cache-policy.test.ts tests/pwa-manifest.test.ts tests/health-api.test.ts tests/integration/health.test.ts",
    "format": "biome check --write --linter-enabled=false src/lib/pwa src/pages/api/health.ts tests/pwa-cache-policy.test.ts tests/pwa-manifest.test.ts tests/health-api.test.ts tests/integration/health.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@neondatabase/neon-js": "^0.6.2-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^6.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.6.1",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
